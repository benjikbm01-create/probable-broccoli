 "chats": [
  {
   "a": "wren",
   "b": "sol",
   "lines": [
    "sol: Another round?",
    "wren: You said that two rounds ago.",
    "sol: And I was right then too.",
    "wren: ...Fine. One more."
   ],
   "if": "!lantern_lit"
  },
  {
   "a": "wren",
   "b": "sol",
   "lines": [
    "wren: The stranger asked about the stones.",
    "sol: Ooh. Are you going to be nice to them?",
    "wren: I'm always nice.",
    "sol: You shot Tobias's hat."
   ],
   "if": "met.wren && met.sol && !lantern_lit"
  },
  {
   "a": "sol",
   "b": "wren",
   "lines": [
    "sol: Did you cut me that spar or not?",
    "wren: I cut it. I left it by the fallen pine.",
    "sol: Two years ago?",
    "wren: ...Possibly."
   ],
   "if": "sol_quest && !sol_quest_done"
  },
  {
   "a": "hester",
   "b": "ione",
   "lines": [
    "ione: I found another blank page today.",
    "hester: More tea, love. You can't fight the fog on an empty cup.",
    "ione: That's not how it works.",
    "hester: Drink it anyway."
   ],
   "if": "!lantern_lit"
  },
  {
   "a": "ione",
   "b": "hester",
   "lines": [
    "ione: A letter, Hester. From the Keep.",
    "hester: E.V. I keep turning it over in my head.",
    "ione: Me too. Like a word on the tip of my tongue."
   ],
   "if": "letter_identified"
  },
  {
   "a": "tobias",
   "b": "sol",
   "lines": [
    "tobias: Wind's backing.",
    "sol: Good. I'm taking her out tomorrow.",
    "tobias: You'll come round the pier by noon, same as always.",
    "sol: Then I'll try again by one."
   ],
   "if": "!lantern_lit"
  },
  {
   "a": "corin",
   "b": "wren",
   "lines": [
    "wren: These arrowheads are too heavy.",
    "corin: Last week they were too light.",
    "wren: They were too light last week.",
    "corin: Give me patience."
   ]
  },
  {
   "a": "tobias",
   "b": "corin",
   "lines": [
    "corin: Evening, Tobias.",
    "tobias: Is it? Fog's so thick I can't tell.",
    "corin: That's what the cider's for."
   ]
  },
  {
   "a": "wren",
   "b": "ione",
   "lines": [
    "wren: You made an agenda.",
    "ione: Agendas are how civilised people have feelings.",
    "wren: ...It was a good agenda.",
    "ione: Thank you."
   ],
   "if": "poly_open && wren_dating && ione_dating"
  },
  {
   "a": "sol",
   "b": "ione",
   "lines": [
    "sol: You're blushing.",
    "ione: I'm not. It's the fire.",
    "sol: We're outside.",
    "ione: It's a very large fire."
   ],
   "if": "poly_open && sol_dating && ione_dating"
  },
  {
   "a": "hester",
   "b": "tobias",
   "lines": [
    "tobias: Elsie. You used to sit on my knee and steal my pipe.",
    "hester: I remember. You let me.",
    "tobias: I let you do everything. Your father despaired."
   ],
   "if": "lantern_lit"
  },
  {
   "a": "wren",
   "b": "sol",
   "lines": [
    "sol: When the Gull's Wing sails, you're coming.",
    "wren: Who'll keep the forest?",
    "sol: The trees can wait a week. Come on, Wren.",
    "wren: ...A week."
   ],
   "if": "lantern_lit"
  }
 ]
